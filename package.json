{
  "name": "hyper-browsing",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "browserd": "node scripts/launcher.mjs browserd",
    "webctl": "node scripts/launcher.mjs webctl",
    "registry:build": "node scripts/launcher.mjs webctl registry build",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium",
    "validate:sites": "node scripts/launcher.mjs webctl site validate",
    "bootstrap": "node scripts/launcher.mjs bootstrap",
    "doctor": "node scripts/launcher.mjs webctl browser status",
    "clean": "node scripts/clean.mjs",
    "test:scenarios": "node tests/chrome-manager-scenarios.mjs",
    "test:learning": "node --import tsx --test tests/learning-policy.mjs tests/asset-recovery.mjs tests/learning-assets.mjs tests/learning-cli.mjs tests/learning-status.mjs",
    "test:execution": "node --import tsx --test tests/execution.mjs tests/transport.mjs tests/headed-fallback.mjs tests/improvements.mjs tests/input-pacing.mjs tests/reliability.mjs",
    "test:discovery": "node --import tsx tests/discovery-lessons.mjs",
    "test": "npm run typecheck && npm run test:mcp && npm run test:learning && npm run test:execution && npm run test:scenarios && npm run test:discovery",
    "mcp": "node bin/hyper-browsing.mjs mcp",
    "test:mcp": "node --import tsx --test tests/mcp.mjs tests/package-cli.mjs tests/smart-scroll.mjs",
    "test:install": "node tests/install-smoke.mjs"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "playwright": "^1.55.0",
    "yaml": "^2.0.0",
    "zod": "^4.0.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Local-first Chrome automation for AI agents: native MCP, reusable site workflows and typed CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miter37/hyper-browsing.git"
  },
  "homepage": "https://github.com/miter37/hyper-browsing",
  "bugs": {
    "url": "https://github.com/miter37/hyper-browsing/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "playwright",
    "chrome",
    "agents"
  ],
  "bin": {
    "hyper-browsing": "bin/hyper-browsing.mjs"
  },
  "files": [
    "bin/hyper-browsing.mjs",
    "scripts/",
    "src/",
    "sites/",
    "templates/",
    "mcp/",
    "docs/",
    "SKILL.md",
    "HERMES_INSTALL.md",
    "README.md",
    "README.ko.md",
    ".env.example",
    "LICENSE"
  ]
}
