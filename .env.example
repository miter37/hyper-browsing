# All of these are optional. The defaults work on Windows, macOS and Linux with no setup.

# Browser daemon RPC. When unset, the daemon uses 3219 or the next free port and records the
# choice in .runtime/browserd-endpoint.json. Setting this pins the port exactly.
# WEBAGENT_PORT=3219

# Chrome runs headless (no visible window) by default. This is just the starting point, not a
# fixed choice: `webctl browser reveal` opens a visible window on demand (login wall, CAPTCHA,
# 2FA, anything that needs a human), and `webctl browser hide` returns to headless - that
# runtime choice always overrides this setting. Set this only to change the starting point
# itself, e.g. to always start visible:
# WEBAGENT_HEADLESS=0

# Chrome profile.
# Unset = auto: drive the FIRST Chrome profile found on this machine.
# Set a directory name ("Profile 1") or display name to pin a specific profile instead.
# WEBAGENT_CHROME_PROFILE_NAME=Profile 1

# auto    - first profile; real directory when Chrome allows it, agent-owned mirror otherwise
# managed - always an agent-owned directory under .runtime (never touches the real profile)
# real    - always the real Chrome profile directory (fails on Chrome 136+)
# WEBAGENT_CHROME_PROFILE_STRATEGY=auto

# Allow the agent to restart a stale Chrome that is holding its OWN profile directory.
# The user's personal Chrome is never terminated regardless of this setting.
WEBAGENT_FORCE_PROFILE_TAKEOVER=1

# Preferred Chrome DevTools port; the next free port is used when it is taken.
WEBAGENT_CDP_PORT=9223
WEBAGENT_CHROME_STARTUP_TIMEOUT_MS=20000

# Optional overrides:
# WEBAGENT_CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# WEBAGENT_CHROME_EXECUTABLE=/usr/bin/google-chrome
# WEBAGENT_CHROME_USER_DATA_DIR=/custom/non-standard/user-data-dir
# WEBAGENT_CHROME_PROFILE_DIRECTORY=Default

# Download Playwright's bundled Chromium as well (not needed; the agent drives installed Chrome).
# WEBAGENT_INSTALL_PLAYWRIGHT_CHROMIUM=1

# Advanced execution. Both are OFF by default and require a trusted local operator.
# Raw eval can submit forms/send requests even if its expression appears to read data.
# WEBAGENT_ALLOW_UNSAFE_EVAL=1  # webctl eval also requires --confirm
# Site actions.ts modules run with full local Node.js permissions; the scan is NOT a sandbox.
# WEBAGENT_ALLOW_CODE_ACTIONS=1

# Advanced runtime paths
# WEBAGENT_RUNTIME_DIR=/some/private/runtime/path
# WEBAGENT_DEBUG=1
